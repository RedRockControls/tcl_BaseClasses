<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.19">
  <POU Name="Test_F_DINT_TO_UDINT_Conversion" Id="{7618d050-2f09-4dc1-a5bb-d62f65f5c08f}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK Test_F_DINT_TO_UDINT_Conversion EXTENDS T_UnitTestBase IMPLEMENTS I_UnitTest
VAR
    InputValue     : DINT;
    ConvertedValue : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="RunTest" Id="{6ed875d1-3fde-410a-857e-06de330f684a}">
      <Declaration><![CDATA[{attribute 'analysis' := '-33'} // inhibit unused variable warning
METHOD RunTest
]]></Declaration>
      <Implementation>
        <ST><![CDATA[InputValue     := DINT#-1;                  // out of range
ConvertedValue := F_DINT_TO_UDINT(InputValue); // limit to smalles UDINT

AssertEquals_UDINT(Expected := 0,
                  Actual   := ConvertedValue,
                  Message  := 'ConvertedValue is not correct');

TestCompleted();
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>