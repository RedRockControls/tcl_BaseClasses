<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.19">
  <POU Name="Test_NotificationNoArgs" Id="{b0e0872e-d94f-4d7d-8638-6a5be13a36bd}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK Test_NotificationNoArgs EXTENDS T_UnitTestBase IMPLEMENTS I_UnitTest
VAR
    Notification        : T_Notification<5>;
    NotificationHandler : T_NotificationHandler;
    IsRaised            : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="RunTest" Id="{05a006be-4cb6-4ddd-80b2-0abb8e5d388d}">
      <Declaration><![CDATA[{attribute 'analysis' := '-33'} // inhibit unused variable warning
METHOD RunTest
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Notification.ClearNotificationHandlers().AddNotificationHandler(NotificationHandler);

Notification.Raise();
IsRaised := NotificationHandler.IsRaised();

AssertIsTrue(Condition := IsRaised,
             Message   := 'IsRaised is not true');

TestCompleted();
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>