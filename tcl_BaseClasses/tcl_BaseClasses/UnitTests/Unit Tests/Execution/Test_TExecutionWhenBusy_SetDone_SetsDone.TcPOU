<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.19">
  <POU Name="Test_TExecutionWhenBusy_SetDone_SetsDone" Id="{3b0968c7-1b7c-46b9-9efb-9a2380279946}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK Test_TExecutionWhenBusy_SetDone_SetsDone EXTENDS T_UnitTestbase  IMPLEMENTS I_UnitTest
VAR
    Execution : T_Execution;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
]]></ST>
    </Implementation>
    <Method Name="RunTest" Id="{f92519b4-385e-4852-a8fe-c1f3edca25b9}">
      <Declaration><![CDATA[{attribute 'analysis' := '-33'} // inhibit unused variable warning
METHOD RunTest
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Test...
Execution.Clear();
Execution.Start();
Execution.SetBusy();
Execution.SetDone();

AssertIsTrue(Condition := Execution.Done,
             Message   := 'Execution.Done not true');

AssertIsTrue(Condition := Execution.Ready,
             Message   := 'Execution.Ready not true');

SUPER^.TestCompleted();
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>