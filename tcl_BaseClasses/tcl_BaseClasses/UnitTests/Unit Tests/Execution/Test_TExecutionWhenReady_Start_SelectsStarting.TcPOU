  <POU Name="Test_TExecutionWhenReady_Start_SelectsStarting" Id="{0349ca1d-2308-406f-93fd-15ff4a011555}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK Test_TExecutionWhenReady_Start_SelectsStarting EXTENDS T_UnitTestbase  IMPLEMENTS I_UnitTest
VAR
    Execution : T_Execution;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
]]></ST>
    </Implementation>
    <Method Name="RunTest" Id="{f67e2ae3-dccd-435c-ab38-3d5cd2aad280}">
      <Declaration><![CDATA[{attribute 'analysis' := '-33'} // inhibit unused variable warning
METHOD RunTest
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Test...
Execution.Clear();
Execution.Start();

AssertIsTrue(Condition := Execution.Starting,
             Message   := 'Execution.Starting not true');

SUPER^.TestCompleted();
]]></ST>
      </Implementation>
    </Method>
